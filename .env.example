# Copiez ce fichier vers .env.local (dev) et configurez les mêmes variables comme secrets
# Cloudflare Workers en production (jamais commitées). Voir README.md section "Authentification".

# --- Microsoft Entra ID (inscription d'application requise dans le tenant INSEPTI) ---
# Portail Azure > Microsoft Entra ID > Inscriptions d'applications > Nouvelle inscription.
# Type de compte prise en charge: comptes de cet annuaire uniquement (single-tenant).
# Redirect URI (Web): https://<votre-domaine>/api/auth/callback  (et http://localhost:3000/api/auth/callback en dev)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=valeur-secrete-a-generer-dans-azure
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login

# --- Autorisation ---
# Domaines e-mail autorisés, séparés par des virgules (ex: insepti.com,insepti.fr). Vide = personne
# n'est autorisé par cette voie tant que l'allowlist DB ou le compte de démarrage ne le permettent pas.
ALLOWED_EMAIL_DOMAINS=insepti.com

# E-mail qui obtient automatiquement le rôle admin à sa toute première connexion (bootstrap).
# À retirer ou changer une fois qu'au moins un administrateur existe en base.
BOOTSTRAP_ADMIN_EMAIL=admin@insepti.com

# --- Notion (lecture seule, utilisé uniquement par scripts/notion-export.mjs en local) ---
# Ne jamais commiter cette valeur. Voir .env.notion.local (déjà dans .gitignore).
# NOTION_TOKEN=secret_xxx
