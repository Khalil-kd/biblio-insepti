# Copiez ce fichier vers .env.local (développement) ou vers les variables d'environnement de Cloud Run / Secret Manager.
# Aucune valeur réelle ne doit être committée.

# --- Base de données PostgreSQL (Cloud SQL / local) ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/insepti_biblio
# Optional override used during database rotations on Render.
DATABASE_URL_V2=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=insepti_biblio
DB_USER=postgres
DB_PASSWORD=postgres

# --- Microsoft Entra ID (tenant, application et URLs) ---
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-me
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
ENTRA_AUTHORITY_BASE_URL=https://login.microsoftonline.com
ENTRA_LOGOUT_ENDPOINT=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/logout

# --- Autorisation ---
ALLOWED_EMAIL_DOMAINS=insepti.com
BOOTSTRAP_ADMIN_EMAIL=admin@insepti.com

# --- Notion (lecture seule) ---
NOTION_DATABASE_ID=656f43db-c032-4e45-9016-6278448014fa
NOTION_TOKEN=

# --- Cloud Run / Secret Manager ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
CLOUD_SQL_INSTANCE_CONNECTION_NAME=your-project:europe-west1:insepti-db
CLOUD_SQL_PASSWORD_SECRET_NAME=insepti-db-password
CLOUD_SQL_USER=postgres
CLOUD_SQL_DB_NAME=insepti_biblio
